{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/project.schema.json",
  "title": "Second Brain Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "language",
    "status",
    "authority_model",
    "confidentiality_default",
    "root_nodes",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"},
    "status": {"enum": ["active", "paused", "archived"]},
    "authority_model": {"const": "compiled-state"},
    "confidentiality_default": {
      "enum": ["public", "internal", "confidential", "personal-data", "sensitive", "prohibited"]
    },
    "root_nodes": {
      "type": "array",
      "items": {"type": "string", "minLength": 3, "maxLength": 80},
      "uniqueItems": true
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
