{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/pending.schema.json",
  "title": "Pending Work Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "title", "priority", "status", "owner",
    "opened_at", "impact", "dependencies", "closure_criteria", "evidence", "links"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^PEND-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "priority": {"enum": ["critical", "high", "medium", "low"]},
    "status": {"enum": ["open", "blocked", "in-progress", "closed", "cancelled"]},
    "owner": {"type": "string", "minLength": 1},
    "opened_at": {"type": "string", "format": "date-time"},
    "impact": {"type": "string", "minLength": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "closure_criteria": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "links": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
