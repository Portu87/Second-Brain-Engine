{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/decision.schema.json",
  "title": "Decision Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "title", "status", "decided_at",
    "effective_from", "approved_by", "source_ids", "rationale", "operations", "supersedes", "links"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "status": {"enum": ["proposed", "approved", "rejected", "superseded"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "effective_from": {"type": "string", "format": "date-time"},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 160},
    "source_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{2,63}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "rationale": {"type": "string", "minLength": 1, "maxLength": 5000},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "rule"],
            "properties": {
              "op": {"const": "upsert_rule"},
              "rule": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule_id", "entity", "field", "value", "scope"],
                "properties": {
                  "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
                  "entity": {"type": "string", "minLength": 1, "maxLength": 120},
                  "field": {"type": "string", "minLength": 1, "maxLength": 120},
                  "value": {},
                  "scope": {"type": "string", "minLength": 1, "maxLength": 160},
                  "status": {"enum": ["active", "inactive"]},
                  "effective_from": {"type": "string", "format": "date-time"},
                  "links": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "rule_id"],
            "properties": {
              "op": {"const": "deactivate_rule"},
              "rule_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
            }
          }
        ]
      }
    },
    "supersedes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9-]{2,63}$"},
      "uniqueItems": true
    },
    "links": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
