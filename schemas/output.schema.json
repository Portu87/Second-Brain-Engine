{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/output.schema.json",
  "title": "Derived Output Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "title", "created_at", "generator",
    "canon_sha256", "source_ids", "decision_ids", "artifact_path", "status", "links"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^OUT-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "generator": {"type": "string", "minLength": 1},
    "canon_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "artifact_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "final", "withdrawn"]},
    "links": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
