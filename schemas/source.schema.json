{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/source.schema.json",
  "title": "Immutable Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "project_id", "title", "origin", "ingested_at",
    "classification", "media_type", "path", "sha256", "size_bytes", "status", "links"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240},
    "origin": {"type": "string", "minLength": 1, "maxLength": 500},
    "ingested_at": {"type": "string", "format": "date-time"},
    "classification": {
      "enum": ["public", "internal", "confidential", "personal-data", "sensitive", "prohibited"]
    },
    "media_type": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "path": {"type": "string", "pattern": "^sources/raw/"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "status": {"enum": ["active", "withdrawn", "quarantined"]},
    "links": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
