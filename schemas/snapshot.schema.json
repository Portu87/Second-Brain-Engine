{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-brain-engine.dev/schemas/snapshot.schema.json",
  "title": "Compiled Canonical Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project_id", "authority_model", "decision_ids", "rules",
    "content_sha256", "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "authority_model": {"const": "compiled-state"},
    "decision_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DEC-[A-Z0-9][A-Z0-9-]{2,63}$"},
      "uniqueItems": true
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "rule_id", "project_id", "entity", "field", "value", "scope", "status",
          "decision_id", "source_ids", "effective_from", "revision"
        ],
        "properties": {
          "rule_id": {"type": "string"},
          "project_id": {"type": "string"},
          "entity": {"type": "string"},
          "field": {"type": "string"},
          "value": {},
          "scope": {"type": "string"},
          "status": {"enum": ["active", "inactive"]},
          "decision_id": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "effective_from": {"type": "string", "format": "date-time"},
          "revision": {"type": "integer", "minimum": 1}
        }
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
